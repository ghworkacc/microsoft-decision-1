{
    "name": "poc-decide-something",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "test": "vitest --no-watch",
        "integration-test": "vitest --no-watch --config vitest.int.config.js",
        "lint": "eslint .",
        "build": "vite build",
        "preview": "vite preview",
        "publish": "D=../static_repo/microsoft-decision-1-example && git -C $D checkout gh-pages && vite build --base=/microsoft-decision-1-example/ && cp -r dist/. $D/ && touch $D/.nojekyll && git -C $D add -A && (git -C $D diff --cached --quiet || git -C $D commit -m 'Publish frontend build') && git -C $D push origin gh-pages"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@eslint/json": "^0.13.1",
        "@njax/eslint-plugin-import": "^2.32.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.3.0",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.10",
        "vite": "^7.0.4",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@azure/msal-browser": "^5.25.0",
        "@azure/msal-react": "^5.7.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
