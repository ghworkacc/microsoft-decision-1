# Template for .env.local. The postprovision hook (scripts/exe/postprovision)
# fills in the placeholders below from the azd environment and writes
# frontend/.env.local. Vite inlines VITE_* values at build time; none of these
# are secrets.
VITE_ENTRA_CLIENT_ID=${ENTRA_CLIENT_ID}
VITE_ENTRA_TENANT_ID=${AZURE_TENANT_ID}
VITE_FOUNDRY_ENDPOINT=${FOUNDRY_ENDPOINT}
VITE_DECISION_DEPLOYMENT=${DECISION_DEPLOYMENT_NAME}
