#!/usr/bin/env ruby
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "azd_support"

AzdSupport::LogAzd.tee_to_log!("preprovision")
AzdSupport::LifecycleRunner.run("preprovision") do |runner|
  runner.step("ensure_azd_defaults") { AzdSupport::Provisioning::EnsureAzdDefaults.run }
  runner.step("validate_local_environment") { AzdSupport::Validation::LocalEnvironment.run }
end
