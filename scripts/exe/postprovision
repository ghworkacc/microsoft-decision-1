#!/usr/bin/env ruby
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "azd_support"

AzdSupport::LogAzd.tee_to_log!("postprovision")
AzdSupport::LifecycleRunner.run("postprovision") do |runner|
  runner.step("register_spa_app") { AzdSupport::Provisioning::RegisterSpaApp.run }
  runner.step("write_frontend_env") { AzdSupport::Provisioning::WriteFrontendEnv.run }
end
